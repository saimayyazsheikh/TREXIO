rules_version = '2';

// Rules v1 (Phase 1): users + businesses. Everything else stays denied until its phase opens it.
// Roles come from custom claims set by server routes, never from client-supplied data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'admin';
    }
    function isEmployee() {
      return signedIn() && request.auth.token.get('role', '') == 'employee';
    }

    // Profiles are created and changed only by server routes (Admin SDK bypasses rules).
    // The one client write allowed is the admin attaching a profile photo.
    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl'])
        && (request.resource.data.photoUrl == null || request.resource.data.photoUrl is string);
    }

    match /businesses/{businessId} {
      allow read: if isAdmin() || (isEmployee() && request.auth.token.businessId == businessId);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.active is bool
        && request.resource.data.workDays is list
        && request.resource.data.workDays.size() >= 1;
      allow delete: if isAdmin();
    }

    // Tasks, routines, audit and activity are written ONLY by server routes (Admin SDK bypasses rules), so every
    // change passes the shared writer that records audit + activity. Clients just read.
    match /tasks/{taskId} {
      allow read: if isAdmin() || (isEmployee() && request.auth.uid in resource.data.assigneeIds);
      allow write: if false;
    }

    match /taskTemplates/{templateId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /activity/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reminders: written by the server. A recipient may only stamp THEIR OWN read receipt with the server time.
    match /reminders/{reminderId} {
      allow read: if isAdmin() || (isEmployee() && request.auth.uid in resource.data.toUids);
      allow create, delete: if false;
      allow update: if isEmployee()
        && request.auth.uid in resource.data.toUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.readBy[request.auth.uid] == request.time;
    }

    // Questions (formal help threads): the admin and the employee who asked. All writes go through the server.
    match /questions/{questionId} {
      allow read: if isAdmin() || (isEmployee() && resource.data.employeeId == request.auth.uid);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isEmployee() && get(/databases/$(database)/documents/questions/$(questionId)).data.employeeId == request.auth.uid);
        allow write: if false;
      }
    }

    // Chat: the admin everywhere; an employee only in "everyone" and their own direct chat (dm_<uid>).
    // Messages are written by the server; the only client write is your own "typing" marker.
    function chatAccess(chatId) {
      return isAdmin() || (isEmployee() && (chatId == 'everyone' || chatId == 'dm_' + request.auth.uid));
    }

    match /chats/{chatId} {
      allow read: if chatAccess(chatId);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if chatAccess(chatId);
        allow write: if false;
      }

      match /typing/{uid} {
        allow read: if chatAccess(chatId);
        allow create, update: if chatAccess(chatId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.at == request.time;
        allow delete: if chatAccess(chatId) && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
