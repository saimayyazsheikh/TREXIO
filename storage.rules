rules_version = '2';

// Storage rules v1: avatars, business logos and per-user files. Roles come from custom claims.
service firebase.storage {
  match /b/{bucket}/o {

    function hasRole() {
      return request.auth != null && request.auth.token.role in ['admin', 'employee'];
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Profile photos: visible to the team (chat, boards); written by the owner or the admin.
    match /avatars/{uid} {
      allow read: if hasRole();
      allow write: if (isAdmin() || (hasRole() && request.auth.uid == uid)) && isImageUnder(2 * 1024 * 1024);
      allow delete: if isAdmin() || (hasRole() && request.auth.uid == uid);
    }

    match /logos/{businessId} {
      allow read: if hasRole();
      allow write: if isAdmin() && isImageUnder(2 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // Private per-user files (attachments in later phases): owner and admin only.
    match /u/{uid}/{allPaths=**} {
      allow read: if hasRole() && (request.auth.uid == uid || isAdmin());
      allow write: if hasRole() && (request.auth.uid == uid || isAdmin()) && request.resource.size < 10 * 1024 * 1024;
      allow delete: if hasRole() && (request.auth.uid == uid || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
