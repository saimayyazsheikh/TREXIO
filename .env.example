# Firebase web config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Set to true to talk to local Firebase emulators (npm run emulators)
NEXT_PUBLIC_USE_EMULATORS=false

# Firebase Admin (service account JSON values). Keep the private key on one line with literal \n
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Cron endpoints: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# AI weekly summary: set one key. With none, a built-in template writes the summary (no AI, no cost).
# AI_PROVIDER picks one explicitly (anthropic, gemini or mock); AI_MODEL overrides the model (default claude-opus-5-5 / gemini-2.5-flash).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=
AI_MODEL=

APP_TIMEZONE=Asia/Karachi
