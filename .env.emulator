# Local development against the Firebase emulators. No real project or secrets are involved.
#   npm run emulators        (terminal 1)
#   npm run seed:emulator    (once, terminal 2)
#   npm run dev:emulated     (terminal 2)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-traxio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-traxio
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://demo-traxio-default-rtdb.firebaseio.com
NEXT_PUBLIC_USE_EMULATORS=true

FIREBASE_ADMIN_PROJECT_ID=demo-traxio
FIREBASE_DATABASE_URL=https://demo-traxio-default-rtdb.firebaseio.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Stops the Admin SDK from probing Google's metadata server for credentials that don't exist locally (silences a warning).
METADATA_SERVER_DETECTION=none

# Lets you try the nightly job locally: curl -H "Authorization: Bearer local-dev-secret" http://localhost:3000/api/cron/generate-daily-tasks
CRON_SECRET=local-dev-secret
